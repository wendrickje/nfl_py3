# Optional current-odds ingestion. Copy to a local .env file or set this in
# your PowerShell session; .env files and credentials are ignored by Git.
THE_ODDS_API_KEY=

# Optional splashsports.com spread ingestion. Requires the `splashsports`
# extra (`uv sync --extra splashsports` then `playwright install chromium`).
# `nfl-ats splashsports-ingest` prefers a saved session (created once via
# `nfl-ats splashsports-login`, which opens a browser for you to sign in by
# hand; saved to data/market/splashsports/auth_state.json, already
# gitignored under data/market/**) and falls back to filling this form with
# the credentials below. Splashsports gates sign-in behind reCAPTCHA, which
# can reject the automated form fill if a manual sign-in is active in
# another session/tab at the same time — the saved-session path avoids that.
SPLASHSPORTS_EMAIL=
SPLASHSPORTS_PASSWORD=

# Optional licensed live NFL injury-report capture. The scheduler enables the
# Sportradar jobs only when this is present in its process environment.
SPORTRADAR_API_KEY=
