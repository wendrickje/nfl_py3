# Optional current-odds ingestion. Copy to a local .env file or set this in
# your PowerShell session; .env files and credentials are ignored by Git.
THE_ODDS_API_KEY=

# Optional splashsports.com login for `nfl-ats splashsports-ingest`. Requires
# the `splashsports` extra (`uv sync --extra splashsports` then
# `playwright install chromium`).
SPLASHSPORTS_EMAIL=
SPLASHSPORTS_PASSWORD=
